CONFIG_IDF_TARGET="esp32s3"

# The dev board has a 16MB flash chip; the ESP-IDF default is 2MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The native USB port (GPIO19/20) is dedicated to hosting the mouse + keyboard,
# so it cannot also serve the USB-Serial-JTAG console — they share the same PHY.
# Logs therefore go out over UART0 (the dev-kit's UART-bridge port). See README.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The mouse and keyboard connect through an external USB hub, so the host stack
# must support hubs (off by default). Low-speed devices behind a hub — most
# basic wired mice and keyboards — are supported out of the box as of ESP-IDF
# v5.5; on v5.4 that needed experimental flags and crashed on enumeration errors.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
