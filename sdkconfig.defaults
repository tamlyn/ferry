CONFIG_IDF_TARGET="esp32s3"

# The dev board has a 16MB flash chip; the ESP-IDF default is 2MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The native USB port (GPIO19/20) is dedicated to hosting the mouse + keyboard,
# so it cannot also serve the USB-Serial-JTAG console — they share the same PHY.
# Logs therefore go out over UART0 (the dev-kit's UART-bridge port). See README.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The mouse and keyboard connect through an external USB hub, so the host stack
# must support hubs (off by default). Low-speed devices behind a hub — most
# basic wired mice and keyboards — are supported out of the box as of ESP-IDF
# v5.5; on v5.4 that needed experimental flags and crashed on enumeration errors.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Bluetooth: we present as a BLE HID-over-GATT peripheral (mouse + keyboard) via
# the NimBLE host stack. NimBLE keeps CCCD (notify-enabled) state *per connection*,
# which is what lets us hold two live host links at once and route input to either
# — the KVM behaviour M3 is built on (Bluedroid shares one CCCD value across hosts
# and cannot). NimBLE also ships built-in HOGP service builders (HID/battery/
# device-info), so we don't hand-build the GATT attribute table.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Enable NimBLE's built-in HID service builder (ble_svc_hid); off by default.
CONFIG_BT_NIMBLE_HID_SERVICE=y

# A fourth HID report characteristic. NimBLE sizes its rpts[] array to this max
# (default 3 — our mouse input, keyboard input, keyboard LED output); the
# relative-pointer report (id 3) used for display-boundary crossings is a fourth.
# Each host also gains a 5th CCCD for it (10 total across two hosts, still under
# CONFIG_BT_NIMBLE_MAX_CCCDS=16).
CONFIG_BT_NIMBLE_SVC_HID_MAX_RPTS=4

# Two simultaneous host links — the whole point of M3. (Default is 3.)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# Persist bonding keys across reboots so paired hosts reconnect without re-pairing
# (PRD FR6). Off by default in NimBLE.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Headroom in the bond/CCCD stores. The defaults (3 bonds, 8 CCCDs) sit exactly
# at two hosts' worth of persisted state — each bonded host stores 4 CCCDs
# (service-changed, battery, mouse report, keyboard report) — and NimBLE's
# response to an overflowing store is to silently unpair the oldest peer
# (ble_store_util_status_rr). One stray re-pair under a new host identity is
# then enough to delete a live host's bond behind its back; that host keeps its
# own keys, fails encryption on reconnect, and looks mysteriously dead until
# re-paired. Doubling the CCCD store and one spare bond keeps a transient third
# pairing from evicting a real one.
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=16

# Quieten the NimBLE host: at the default INFO level it logs one line per report
# notification, which floods UART0 (our only console) whenever the mouse moves.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# Require encryption on the HID service characteristics (Security Mode 1 Level 2).
# HOGP mandates this, and macOS enforces it: it only initiates pairing when it
# hits an "insufficient encryption" error accessing a characteristic. At the
# default level 0 the reports are readable in the clear, so macOS connects,
# subscribes, but never bonds — its Bluetooth UI then spins forever. Level 2 adds
# encryption without authentication, so our keypad-less Just Works pairing still
# satisfies it. (Windows tolerates level 0; macOS does not.)
CONFIG_BT_NIMBLE_SM_LVL=2

# Give the app a larger partition and keep an NVS partition for the bonds (the
# 16MB flash has ample room).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
