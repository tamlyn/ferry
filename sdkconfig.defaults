CONFIG_IDF_TARGET="esp32s3"

# The dev board has a 16MB flash chip; the ESP-IDF default is 2MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The native USB port (GPIO19/20) is dedicated to hosting the mouse + keyboard,
# so it cannot also serve the USB-Serial-JTAG console — they share the same PHY.
# Logs therefore go out over UART0 (the dev-kit's UART-bridge port). See README.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# The mouse and keyboard connect through an external USB hub, so the host stack
# must support hubs (off by default). Low-speed devices behind a hub — most
# basic wired mice and keyboards — are supported out of the box as of ESP-IDF
# v5.5; on v5.4 that needed experimental flags and crashed on enumeration errors.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# Bluetooth: we present as a BLE HID-over-GATT peripheral (mouse + keyboard) via
# the NimBLE host stack. NimBLE keeps CCCD (notify-enabled) state *per connection*,
# which is what lets us hold two live host links at once and route input to either
# — the KVM behaviour M3 is built on (Bluedroid shares one CCCD value across hosts
# and cannot). NimBLE also ships built-in HOGP service builders (HID/battery/
# device-info), so we don't hand-build the GATT attribute table.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# Enable NimBLE's built-in HID service builder (ble_svc_hid); off by default.
CONFIG_BT_NIMBLE_HID_SERVICE=y

# Two simultaneous host links — the whole point of M3. (Default is 3.)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2

# Persist bonding keys across reboots so paired hosts reconnect without re-pairing
# (PRD FR6). Off by default in NimBLE.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Give the app a larger partition and keep an NVS partition for the bonds (the
# 16MB flash has ample room).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
